default_platform(:android)

# ---------------------------------------------------------------------------
# Timeline Exporter — screenshot capture, decoration + Play Store upload.
#
# Typical flow (see SCREENSHOTS_SETUP.md and tools/store_shots/README.md):
#   1. boot a PHONE emulator,  then:  bundle exec fastlane screens_phone
#      (add locales:ru-RU,ar to any screens_* lane for a quick two-language pass)
#   2. boot a 7" TABLET emul., then:  bundle exec fastlane screens_tablet7
#   3. boot a 10" TABLET emul, then:  bundle exec fastlane screens_tablet10
#   4. review fastlane/metadata/android/<locale>/images/...
#   5. upload:                        bundle exec fastlane upload_screens
#
# The screens_* lanes now do three things: capture raw shots, move them into
# fastlane/screenshots_raw/, then render the framed store art from them. To
# re-render after a copy change you do NOT need an emulator — just run
# `bundle exec fastlane decorate_screens`.
# ---------------------------------------------------------------------------

SHOTS = "../tools/store_shots"

# Options for one capture pass. `locales:ru-RU,ar` on any screens_* lane runs
# just those two languages instead of all 18 — a full pass is 25-40 minutes, a
# long way to go to check one change. Left out, the Screengrabfile's list is
# used, so the key is omitted rather than passed as nil. `device:<serial>`
# pins the pass to one adb device, so a phone left plugged in next to the
# emulator does not make screengrab stop at "multiple devices".
def capture_options(device_type, options)
  args = { device_type: device_type }
  args[:locales] = options[:locales].split(",") if options[:locales]
  args[:specific_device] = options[:device] if options[:device]
  args
end

# The newest build on the internal track, which is the release supply attaches
# the screenshots to. Read from Play on every upload: it was hard-coded as 18
# and went stale as soon as 19 was uploaded.
def internal_version_code
  google_play_track_version_codes(track: "internal").max
end

platform :android do

  desc "Build the debug app + instrumentation APKs that screengrab drives"
  lane :build_for_screengrab do
    gradle(
      task: "assembleDebug assembleDebugAndroidTest",
      flags: "--stacktrace"
    )
  end

  desc "One-time: install the screenshot renderer's dependencies (Node 18+)"
  lane :setup_store_shots do
    sh("npm", "install", "--prefix", SHOTS)
    sh("npx", "--prefix", SHOTS, "playwright", "install", "chromium")
  end

  desc "Move fresh screengrab output out of metadata/ into fastlane/screenshots_raw/"
  private_lane :ingest_raw do |options|
    sh("node", "#{SHOTS}/render.mjs", "--ingest", "--slot", options[:slot])
  end

  desc "Render the framed Play Store screenshots from the raw captures. " \
       "Options: slot:phone|sevenInch|tenInch, locales:ru-RU,ar, palette:blue|orange|midnight"
  lane :decorate_screens do |options|
    args = ["node", "#{SHOTS}/render.mjs"]
    args += ["--slot",    options[:slot]]    if options[:slot]
    args += ["--locales", options[:locales]] if options[:locales]
    args += ["--palette", options[:palette]] if options[:palette]
    sh(*args)
  end

  desc "Capture screenshots on a PHONE emulator/device (run one first)"
  lane :screens_phone do |options|
    build_for_screengrab
    begin
      capture_android_screenshots(capture_options("phone", options))
    ensure
      # a run that dies part-way (adb hiccup, Ctrl-C) still leaves captures in
      # metadata/ — move them to raw before the error propagates, or the next
      # run's clear_previous_screenshots deletes them.
      ingest_raw(slot: "phone")
    end
    decorate_screens(slot: "phone", locales: options[:locales])
  end

  desc "Capture screenshots on a 7-inch TABLET emulator/device"
  lane :screens_tablet7 do |options|
    build_for_screengrab
    begin
      capture_android_screenshots(capture_options("sevenInch", options))
    ensure
      # a run that dies part-way (adb hiccup, Ctrl-C) still leaves captures in
      # metadata/ — move them to raw before the error propagates, or the next
      # run's clear_previous_screenshots deletes them.
      ingest_raw(slot: "sevenInch")
    end
    decorate_screens(slot: "sevenInch", locales: options[:locales])
  end

  desc "Capture screenshots on a 10-inch TABLET emulator/device"
  lane :screens_tablet10 do |options|
    build_for_screengrab
    begin
      capture_android_screenshots(capture_options("tenInch", options))
    ensure
      # a run that dies part-way (adb hiccup, Ctrl-C) still leaves captures in
      # metadata/ — move them to raw before the error propagates, or the next
      # run's clear_previous_screenshots deletes them.
      ingest_raw(slot: "tenInch")
    end
    decorate_screens(slot: "tenInch", locales: options[:locales])
  end

  desc "DEPRECATED — the old Pillow caption band on 01_hero. Superseded by " \
       "decorate_screens; kept so old runs stay reproducible."
  lane :add_hero_captions do
    ENV["PYTHONUTF8"] = "1"
    ENV["PYTHONIOENCODING"] = "utf-8"
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"
    sh("python", "../tools/add_hero_caption.py")
  end

  desc "Upload ONLY screenshots to Play (internal track). Leaves your listing " \
       "text, release notes and the AAB untouched."
  lane :upload_screens do
    upload_to_play_store(
      track: "internal",
      version_code: internal_version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,     # don't overwrite your hand-edited listing
      skip_upload_changelogs: true,   # release notes handled separately
      skip_upload_images: true,       # icon / feature graphic left as-is
      skip_upload_screenshots: false, # <-- the only thing we push
      validate_only: false
    )
  end

  desc "Dry-run the upload (validates, changes nothing on Play)"
  lane :upload_screens_dryrun do
    upload_to_play_store(
      track: "internal",
      version_code: internal_version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false,
      validate_only: true
    )
  end
end

# ---------------------------------------------------------------------------
# iOS — App Store screenshots. Captured on a Mac simulator by
# tools/ios/store_screenshots.sh, framed by `render.mjs --platform ios` into
# fastlane/screenshots_ios/<App Store locale>/, uploaded here. Normally run by
# .github/workflows/ios-screens.yml; by hand:
#   APPSTORE_KEY_ID=… APPSTORE_ISSUER_ID=… APPSTORE_PRIVATE_KEY="$(cat key.p8)" \
#     bundle exec fastlane ios upload_screens
# Needs a version in App Store Connect that is still editable ("Prepare for
# Submission"): screenshots belong to a version, and deliver makes none.
# ---------------------------------------------------------------------------
platform :ios do
  desc "Upload ONLY the framed screenshots to App Store Connect, replacing " \
       "the version's current ones. Listing text, binary and review untouched."
  lane :upload_screens do
    # Lane code runs inside fastlane/, but actions run from the project root,
    # so a relative "./screenshots_ios" handed to deliver points at a folder
    # that does not exist — and deliver then "uploads" nothing and goes green.
    # Resolve it here, absolute, and refuse to run on an empty set (with
    # overwrite_screenshots an empty folder would also wipe what is there).
    shots = File.expand_path("screenshots_ios")
    pngs = Dir.glob(File.join(shots, "*", "*.png"))
    UI.user_error!("No screenshots in #{shots}/<locale>/*.png") if pngs.empty?
    UI.message("#{pngs.size} screenshots in " \
               "#{Dir.glob(File.join(shots, '*')).select { |d| File.directory?(d) }.size} locales from #{shots}")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY"),
      in_house: false
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV["IOS_BUNDLE_ID"] || "com.nikitapetrovapps.timelineexporter",
      screenshots_path: shots,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true # no HTML preview to confirm on CI
    )
  end

  # Listing text: fastlane/listing_ios/<App Store locale>/*.txt (name,
  # subtitle, description, keywords, promotional text, URLs) and
  # review_information/notes.txt. The description repeats the in-app
  # requirement and step strings (ios/strings) - keep them in step.
  desc "Upload ONLY the listing text and App Review notes to App Store "        "Connect. Screenshots, binary, price and review submission untouched."
  lane :upload_metadata do
    tolerate_missing_review_detail
    # Absolute for the same reason as screenshots_ios above: deliver resolves
    # relative paths from the project root, not from fastlane/.
    listing = File.expand_path("listing_ios")
    if Dir.glob(File.join(listing, "*", "description.txt")).empty?
      UI.user_error!("No listing in #{listing}/<locale>/description.txt")
    end
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY"),
      in_house: false
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV["IOS_BUNDLE_ID"] || "com.nikitapetrovapps.timelineexporter",
      metadata_path: listing,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      ignore_language_directory_validation: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  # deliver (2.236) writes the App Review notes, then fetches the review
  # detail again, unrescued, only to clear review attachments. When App Store
  # Connect answers that with no data, spaceship raises "No data" and the
  # whole upload fails although the text is already saved. We attach nothing,
  # so a missing detail there is harmless.
  private_lane :tolerate_missing_review_detail do
    require "deliver"
    Deliver::UploadMetadata.class_eval do
      next if method_defined?(:review_attachment_file_unguarded)
      alias_method :review_attachment_file_unguarded, :review_attachment_file
      define_method(:review_attachment_file) do |version|
        review_attachment_file_unguarded(version)
      rescue RuntimeError => e
        raise unless e.message == "No data"
        FastlaneCore::UI.important("App Review detail not returned; no attachments to clear")
      end
    end
  end
end
