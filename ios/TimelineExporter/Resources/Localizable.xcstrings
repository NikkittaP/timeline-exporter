    "tip_prompt_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل وفّر عليك هذا بعض الوقت؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat dir das Zeit gespart?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did that save you some time?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te ha ahorrado algo de tiempo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela vous a-t-il fait gagner du temps ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या इससे आपका कुछ समय बचा?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ha fatto risparmiare tempo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し時間を節約できましたか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간을 조금 아끼셨나요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft dat je tijd bespaard?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy to oszczędziło ci trochę czasu?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso economizou o seu tempo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сэкономило вам время?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparade det dig lite tid?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sana biraz zaman kazandırdı mı?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це заощадило вам час?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这为你省下了一些时间吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這為你省下了一些時間嗎？"
          }
        }
      }
    },
    "tipjar_blurb" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق Timeline Exporter مجاني وبدون إعلانات ومفتوح المصدر. إذا كان مفيدًا لك، فإن إكرامية صغيرة تصل إليّ مباشرةً. شكرًا لتفكيرك في ذلك!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter ist kostenlos, werbefrei und Open Source. Wenn es nützlich war, geht ein kleines Trinkgeld direkt an mich. Danke, dass du es in Erwägung ziehst!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter is free, ad-free, and open source. If it's been useful, a small tip goes directly to me. Thanks for considering it!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter es gratuito, sin anuncios y de código abierto. Si te ha resultado útil, una pequeña propina llega directamente a mí. ¡Gracias por considerarlo!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter est gratuit, sans publicité et open source. S'il vous a été utile, un petit pourboire me revient directement. Merci d'y penser !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter मुफ़्त, विज्ञापन-रहित और ओपन सोर्स है। अगर यह उपयोगी रहा, तो एक छोटी-सी टिप सीधे मुझ तक पहुँचती है। विचार करने के लिए धन्यवाद!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter è gratuito, senza pubblicità e open source. Se ti è stato utile, una piccola mancia arriva direttamente a me. Grazie per averci pensato!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter は無料・広告なし・オープンソースです。役に立ったら、ささやかなチップが直接私に届きます。ご検討ありがとうございます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter는 무료이며 광고가 없고 오픈 소스입니다. 유용했다면 작은 팁이 저에게 직접 전달됩니다. 고려해 주셔서 감사합니다!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter is gratis, advertentievrij en open source. Als het nuttig was, gaat een kleine fooi rechtstreeks naar mij. Bedankt dat je het overweegt!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter jest darmowy, bez reklam i open source. Jeśli okazał się przydatny, mały napiwek trafia bezpośrednio do mnie. Dziękuję, że bierzesz to pod uwagę!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timeline Exporter é gratuito, sem anúncios e de código aberto. Se foi útil, uma pequena gorjeta vai diretamente para mim. Obrigado por considerar!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter бесплатный, без рекламы и с открытым кодом. Если он оказался полезным, небольшие чаевые идут напрямую мне. Спасибо, что готовы поддержать!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter är gratis, reklamfritt och öppen källkod. Om det varit användbart går en liten dricks direkt till mig. Tack för att du överväger det!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter ücretsiz, reklamsız ve açık kaynaktır. Faydalı olduysa, küçük bir bahşiş doğrudan bana ulaşır. Düşündüğünüz için teşekkürler!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter безкоштовний, без реклами та з відкритим кодом. Якщо він став у пригоді, невеликі чайові йдуть напряму мені. Дякую, що розглядаєте це!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter 免费、无广告且开源。如果它对你有用，一点小费会直接给到我。感谢你的考虑！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter 免費、無廣告且開放原始碼。如果它對你有幫助，一點小費會直接給我。感謝你的考慮！"
          }
        }
      }
    },
