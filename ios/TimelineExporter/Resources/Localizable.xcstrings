    "places_include_containers_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل Google أيضًا المبنى الذي يقع فيه المكان. مُعطَّل افتراضيًا — فهو يكرّر إقامة لديك بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google erfasst auch das Gebäude, in dem ein Ort liegt. Standardmäßig aus – es wiederholt einen Aufenthalt, den du bereits hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google also records the building a place sits inside. Off by default — it repeats a stay you already have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google también registra el edificio en el que se encuentra un lugar. Desactivado por defecto: repite una estancia que ya tienes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google enregistre aussi le bâtiment dans lequel se trouve un lieu. Désactivé par défaut : cela répète un séjour que vous avez déjà."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google उस इमारत को भी दर्ज करता है जिसमें जगह है। डिफ़ॉल्ट रूप से बंद — यह पहले से मौजूद ठहराव को दोहराता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google registra anche l'edificio in cui si trova un luogo. Disattivato per impostazione predefinita: ripete una sosta che hai già."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google は場所が入っている建物も記録します。既定ではオフ: すでにある滞在と重複します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google은 장소가 속한 건물도 기록합니다. 기본적으로 꺼져 있습니다. 이미 있는 방문과 중복됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google registreert ook het gebouw waarin een plaats ligt. Standaard uit: het herhaalt een verblijf dat je al hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google zapisuje też budynek, w którym znajduje się miejsce. Domyślnie wyłączone — powtarza pobyt, który już masz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google também registra o prédio em que um lugar fica. Desativado por padrão: repete uma estadia que você já tem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google записывает и здание, внутри которого находится место. По умолчанию выключено — это дублирует визит, который у вас уже есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google registrerar även byggnaden som en plats ligger i. Av som standard – det upprepar ett besök du redan har."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google, bir yerin içinde bulunduğu binayı da kaydeder. Varsayılan olarak kapalı — zaten sahip olduğunuz bir konaklamayı tekrarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google записує також будівлю, у якій розташоване місце. Типово вимкнено — це дублює візит, який у вас уже є."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 还会记录地点所在的建筑。默认关闭：它会重复你已有的一次停留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 也會記錄地點所在的建築。預設關閉：它會重複你已有的一次停留。"
          }
        }
      }
    },
