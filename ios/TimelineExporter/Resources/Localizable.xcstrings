    "map_image_high_error" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر عرض الصورة عالية الدقة. لم يُحفظ شيء؛ جرّب الدقة القياسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild in hoher Auflösung konnte nicht gerendert werden. Nichts wurde gespeichert; versuche Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't render the high-resolution image. Nothing was saved; try Standard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo renderizar la imagen en alta resolución. No se guardó nada; prueba Estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de rendre l'image en haute résolution. Rien n'a été enregistré ; essayez Standard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उच्च रिज़ॉल्यूशन इमेज रेंडर नहीं हो सकी। कुछ भी सेव नहीं हुआ; मानक आज़माएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile generare l'immagine in alta risoluzione. Non è stato salvato nulla; prova Standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高解像度の画像を描画できませんでした。何も保存されていません。標準をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고해상도 이미지를 렌더링하지 못했습니다. 저장된 것은 없습니다. 표준을 사용해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de afbeelding in hoge resolutie niet renderen. Er is niets opgeslagen; probeer Standaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wyrenderować obrazu w wysokiej rozdzielczości. Nic nie zapisano; spróbuj Standardowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível renderizar a imagem em alta resolução. Nada foi salvo; tente Padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отрисовать изображение в высоком разрешении. Ничего не сохранено; попробуйте стандартное."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att rendera bilden i hög upplösning. Inget sparades; prova Standard."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek çözünürlüklü görüntü işlenemedi. Hiçbir şey kaydedilmedi; Standart'ı deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося відобразити зображення у високій роздільності. Нічого не збережено; спробуйте стандартну."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法渲染高分辨率图片。未保存任何内容；请尝试标准分辨率。"
