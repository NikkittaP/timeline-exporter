        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non ci sono opzioni per la mancia. Di solito significa che l'app non è ancora completamente configurata su Google Play. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、チップのオプションはありません。通常、これはアプリが Google Play でまだ完全に設定されていないことを意味します。後でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 팁 옵션이 없습니다. 보통 앱이 Google Play에서 아직 완전히 설정되지 않았다는 의미입니다. 나중에 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn nu geen fooi-opties beschikbaar. Meestal betekent dit dat de app nog niet volledig is ingesteld in Google Play. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecnie brak dostępnych opcji napiwku. Zwykle oznacza to, że aplikacja nie jest jeszcze w pełni skonfigurowana w Google Play. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No momento não há opções de gorjeta disponíveis. Geralmente isso significa que o app ainda não está totalmente configurado no Google Play. Tente novamente mais tarde."
