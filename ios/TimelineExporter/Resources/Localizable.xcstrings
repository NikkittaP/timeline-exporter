    "feedback_prompt_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطور التطبيق بناءً على طلبات المستخدمين. لا توجد أي تحليلات — أخبرني بما ينقص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wächst mit den Wünschen ihrer Nutzer. Es gibt keine Analytik — sag mir, was fehlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app grows on user requests. There's no analytics — tell me what to add."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
