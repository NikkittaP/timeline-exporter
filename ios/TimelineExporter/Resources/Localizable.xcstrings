    "feedback_diagnostics_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يرسل التطبيق أي شيء بنفسه. تُفتح المسودة في المتصفح أو تطبيق البريد — يمكنك تعديل أي جزء منها أو حذفه قبل الإرسال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App sendet nichts von selbst. Der Entwurf öffnet sich im Browser oder in der Mail-App — du kannst alles vor dem Senden ändern oder löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is sent by the app. The draft opens in your browser or mail app — you can edit or delete any of it before sending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app no envía nada por su cuenta. El borrador se abre en tu navegador o tu correo: puedes editarlo o borrarlo antes de enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application n'envoie rien d'elle-même. Le brouillon s'ouvre dans votre navigateur ou votre messagerie : vous pouvez tout modifier ou supprimer avant l'envoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप अपने आप कुछ नहीं भेजता। ड्राफ़्ट आपके ब्राउज़र या मेल ऐप में खुलेगा — भेजने से पहले आप कुछ भी बदल या हटा सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app non invia nulla da sola. La bozza si apre nel browser o nell'app di posta: puoi modificarla o cancellarla prima di inviarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが勝手に送信することはありません。下書きはブラウザーまたはメールアプリで開くので、送る前に編集も削除もできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 스스로 보내는 것은 없습니다. 초안은 브라우저나 메일 앱에서 열리며, 보내기 전에 얼마든지 고치거나 지울 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app verstuurt zelf niets. Het concept opent in je browser of mailapp — je kunt alles nog aanpassen of wissen voordat je verstuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja sama nic nie wysyła. Wersja robocza otworzy się w przeglądarce lub poczcie — przed wysłaniem możesz wszystko zmienić lub usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app não envia nada sozinho. O rascunho abre no navegador ou no app de e-mail — dá para editar ou apagar tudo antes de enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение ничего не отправляет само. Черновик откроется в браузере или почте — перед отправкой всё можно отредактировать или удалить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen skickar ingenting själv. Utkastet öppnas i webbläsaren eller e-postappen — du kan ändra eller radera allt innan du skickar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kendiliğinden hiçbir şey göndermez. Taslak tarayıcınızda veya e-posta uygulamanızda açılır — göndermeden önce her şeyi düzenleyebilir veya silebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок нічого не надсилає сам. Чернетка відкриється у браузері або пошті — перед надсиланням усе можна змінити чи видалити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用不会自行发送任何内容。草稿会在浏览器或邮件应用中打开，发送前你可以随意修改或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式不會自行傳送任何內容。草稿會在瀏覽器或郵件應用程式中開啟，傳送前你可以隨意修改或刪除。"
          }
        }
      }
    },
