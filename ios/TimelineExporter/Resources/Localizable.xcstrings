    "place_unnamed_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على مكان في الخريطة أو في القائمة لتحديد موقعه. انقر عليه مرة أخرى لتسميته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte oder in der Liste auf einen Ort, um ihn zu finden. Tippe erneut, um ihm einen Namen zu geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a place on the map or in the list to find it. Tap it again to give it a name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un lugar en el mapa o en la lista para localizarlo. Tócalo otra vez para ponerle nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un lieu sur la carte ou dans la liste pour le situer. Appuyez à nouveau pour le nommer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी जगह को ढूँढने के लिए उसे मानचित्र या सूची में टैप करें। नाम देने के लिए दोबारा टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un luogo sulla mappa o nell’elenco per individuarlo. Toccalo di nuovo per dargli un nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図かリストで場所をタップすると位置がわかります。もう一度タップすると名前を付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도나 목록에서 장소를 탭하면 위치를 확인할 수 있습니다. 다시 탭하면 이름을 지정합니다."
