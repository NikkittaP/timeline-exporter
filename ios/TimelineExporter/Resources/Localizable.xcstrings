    "journey_traveler" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس كل من يتجول تائهاً. بعضهم يتمهل فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht alle Wandernden sind verloren. Manche lassen sich einfach Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not all who wander are lost. Some are just taking their time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No todos los que viajan están perdidos. Algunos simplemente se toman su tiempo."
