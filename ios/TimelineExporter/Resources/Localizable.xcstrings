          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение развивается по запросам пользователей. Аналитики нет — расскажите, чего не хватает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
