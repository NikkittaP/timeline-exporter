    "tip_prompt_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Timeline Exporter مجاني، بلا إعلانات ولا يتتبّعك. إن أحببت، يمكنك دعم تطويره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter ist kostenlos, werbefrei und verfolgt dich nicht. Wenn du magst, kannst du die Entwicklung unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter is free, has no ads and doesn't track you. If you'd like, you can support its development."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter es gratuito, sin anuncios y no te rastrea. Si quieres, puedes apoyar su desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter est gratuit, sans publicité et ne vous piste pas. Si vous le souhaitez, vous pouvez soutenir son développement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter मुफ़्त है, इसमें विज्ञापन नहीं हैं और यह आपको ट्रैक नहीं करता। चाहें तो आप इसके विकास में सहयोग कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter è gratuito, senza pubblicità e non ti traccia. Se ti va, puoi sostenerne lo sviluppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter は無料・広告なしで、あなたを追跡しません。よろしければ開発を支援できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter는 무료이고 광고가 없으며 사용자를 추적하지 않습니다. 원하신다면 개발을 후원하실 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter is gratis, advertentievrij en volgt je niet. Als je wilt, kun je de ontwikkeling steunen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter jest darmowy, bez reklam i nie śledzi cię. Jeśli chcesz, możesz wesprzeć jego rozwój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timeline Exporter é gratuito, sem anúncios e não rastreia você. Se quiser, você pode apoiar o desenvolvimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter бесплатный, без рекламы и не следит за вами. Если захотите, можно поддержать разработку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter är gratis, annonsfritt och spårar dig inte. Om du vill kan du stödja utvecklingen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter ücretsizdir, reklam içermez ve seni takip etmez. İstersen geliştirilmesine destek olabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter безкоштовний, без реклами й не стежить за вами. Якщо захочете, можете підтримати розробку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline Exporter 免费、无广告，也不会追踪你。如果愿意，你可以支持它的开发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
