        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nicht nach einer Google-Timeline-Datei aus. Wähle die aus Google Maps exportierte Timeline.json — tippe auf „Hilfe“ für die Schritte."
