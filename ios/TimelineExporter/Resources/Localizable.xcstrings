        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घूमने वाले सभी लोग खोए नहीं होते। कुछ बस आराम से चलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non tutti quelli che vagano si sono persi. Alcuni si prendono il loro tempo."
