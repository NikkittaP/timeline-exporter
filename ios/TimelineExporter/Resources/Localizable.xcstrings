    "time_dialog_local_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوقات بالتوقيت المحلي للمكان الذي سُجّلت فيه كل نقطة، لا بتوقيت هاتفك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten sind die Ortszeit dort, wo der Punkt aufgezeichnet wurde – nicht die Ihres Telefons."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times are the local clock where each point was recorded, not your phone's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas son la hora local del lugar donde se registró cada punto, no la de tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures sont l'heure locale du lieu où chaque point a été enregistré, pas celle de votre téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय वहाँ का स्थानीय है जहाँ बिंदु रिकॉर्ड हुआ, आपके फ़ोन का नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari sono l'ora locale del luogo in cui è stato registrato ogni punto, non quella del telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻は各地点が記録された現地時間です。端末の時刻ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시각은 각 지점이 기록된 현지 시간이며, 휴대전화의 시간이 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijden zijn de lokale klok waar elk punt is vastgelegd, niet die van je telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godziny są lokalne dla miejsca zapisu punktu, a nie dla Twojego telefonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os horários são a hora local de onde cada ponto foi registrado, não a do seu telefone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время — местное там, где записана точка, а не на вашем телефоне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiderna är lokal tid där varje punkt registrerades, inte telefonens."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatler, her noktanın kaydedildiği yerin yerel saatidir; telefonunuzun değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час — місцевий там, де записано точку, а не на вашому телефоні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间为每个点记录地的当地时间，而非手机时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間為各個點記錄地的當地時間，而非手機時間。"
          }
        }
      }
    },
    "time_dialog_places_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى المكان إذا تداخلت إحدى الزيارات إليه مع النطاق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ort bleibt erhalten, wenn ein Besuch dort in das Zeitfenster fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A place is kept when a visit to it overlaps the window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lugar se conserva si alguna visita coincide con el intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieu est conservé si une visite recoupe la plage horaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई स्थान तब रहता है जब उसकी कोई विज़िट इस अवधि से मेल खाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un luogo viene mantenuto se una visita rientra nell'intervallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その場所への滞在が時間帯に重なっていれば、その場所は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 장소 방문이 시간대와 겹치면 그 장소는 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een plaats blijft behouden als een bezoek eraan binnen het venster valt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce zostaje, jeśli któraś wizyta pokrywa się z zakresem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lugar é mantido quando alguma visita a ele cai dentro do intervalo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место остаётся, если визит в него попадает в этот промежуток."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plats behålls om ett besök där överlappar tidsfönstret."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yere yapılan ziyaret aralıkla kesişiyorsa o yer korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місце залишається, якщо візит до нього потрапляє в цей проміжок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要某次到访与该时段有重叠，该地点就会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要某次造訪與該時段重疊，該地點就會保留。"
          }
        }
      }
    },
