    "trips_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُكتشف الرحلة عندما تبتعد عن المنزل أكثر من 50 كم. انقر على رحلة لمعاينتها على الخريطة. حدّد الرحلات لتصديرها وحدها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Reise wird erkannt, wenn du dich mehr als 50 km von zu Hause entfernst. Tippe auf eine Reise, um sie auf der Karte anzusehen. Hake Reisen an, um nur diese zu exportieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trips are detected when you travel more than 50 km from home. Tap a trip to preview it on the map. Tick trips to export only those."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detecta un viaje cuando te alejas más de 50 km de casa. Toca un viaje para verlo en el mapa. Marca viajes para exportar solo esos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un voyage est détecté quand vous vous éloignez de plus de 50 km de chez vous. Touchez un voyage pour l'afficher sur la carte. Cochez des voyages pour n'exporter que ceux-là."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप घर से 50 किमी से ज़्यादा दूर जाते हैं, तब यात्रा पहचानी जाती है। मैप पर देखने के लिए किसी यात्रा पर टैप करें। सिर्फ़ कुछ यात्राएँ एक्सपोर्ट करने के लिए उन पर निशान लगाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viaggio viene rilevato quando ti allontani più di 50 km da casa. Tocca un viaggio per vederlo sulla mappa. Spunta i viaggi per esportare solo quelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅から 50 km 以上離れると旅行として検出されます。旅行をタップすると地図でプレビューできます。チェックを入れた旅行だけを書き出すこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집에서 50km 넘게 이동하면 여행으로 감지됩니다. 여행을 탭하면 지도에서 미리 볼 수 있습니다. 체크한 여행만 내보낼 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een reis wordt herkend als je meer dan 50 km van huis gaat. Tik op een reis om hem op de kaart te bekijken. Vink reizen aan om alleen die te exporteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podróż jest wykrywana, gdy oddalasz się od domu o ponad 50 km. Dotknij podróży, aby zobaczyć ją na mapie. Zaznacz podróże, aby wyeksportować tylko je."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma viagem é detectada quando você se afasta mais de 50 km de casa. Toque em uma viagem para vê-la no mapa. Marque viagens para exportar só elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поездка начинается, когда вы уезжаете от дома дальше чем на 50 км. Нажмите на поездку, чтобы посмотреть её на карте. Отметьте поездки галочкой, чтобы экспортировать только их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En resa upptäcks när du är mer än 50 km hemifrån. Tryck på en resa för att se den på kartan. Bocka för resor för att bara exportera dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evden 50 km'den fazla uzaklaştığınızda bir seyahat algılanır. Haritada görmek için bir seyahate dokunun. Yalnızca bunları dışa aktarmak için seyahatleri işaretleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поїздка починається, коли ви від'їжджаєте від дому далі ніж на 50 км. Торкніться поїздки, щоб переглянути її на мапі. Позначте поїздки, щоб експортувати лише їх."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你离家超过 50 公里时即识别为一次旅行。点按旅行即可在地图上预览。勾选旅行即可只导出这些旅行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你離家超過 50 公里時即識別為一次旅行。輕觸旅行即可在地圖上預覽。勾選旅行即可只匯出這些旅行。"
          }
        }
      }
    },
