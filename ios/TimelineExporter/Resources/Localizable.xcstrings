    "map_image_high_gpu" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدقة العالية غير متاحة لهذا الشكل: إنها أكبر مما تستطيع رسومات هذا الجهاز عرضه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Auflösung ist für dieses Format nicht verfügbar: Sie übersteigt, was die Grafik dieses Geräts rendern kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High resolution isn't available for this shape: it is larger than this device's graphics can render."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La alta resolución no está disponible para esta forma: supera lo que la gráfica de este dispositivo puede renderizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La haute résolution n'est pas disponible pour ce format : elle dépasse ce que le processeur graphique de l'appareil peut rendre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस आकार के लिए उच्च रिज़ॉल्यूशन उपलब्ध नहीं है: यह इस डिवाइस के ग्राफ़िक्स की क्षमता से बड़ा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'alta risoluzione non è disponibile per questa forma: supera ciò che la grafica del dispositivo può generare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この形では高解像度を使用できません。この端末のグラフィックスで描画できるサイズを超えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비율에서는 고해상도를 사용할 수 없습니다. 이 기기의 그래픽이 렌더링할 수 있는 크기를 넘습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoge resolutie is niet beschikbaar voor deze vorm: die is groter dan de grafische chip van dit apparaat kan renderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysoka rozdzielczość jest niedostępna dla tego kształtu: przekracza możliwości grafiki tego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A alta resolução não está disponível para este formato: excede o que os gráficos deste dispositivo conseguem renderizar."
          }
