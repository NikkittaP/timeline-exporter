    "feedback_channel_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub علني ويمكن للآخرين دعم الطلب نفسه. أما البريد فيصلني وحدي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ist öffentlich, andere können denselben Wunsch unterstützen. Die E-Mail erreicht nur mich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub is public and lets others upvote the same request. Email reaches only me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub es público y otras personas pueden apoyar la misma petición. El correo llega solo a mí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub est public, d'autres peuvent soutenir la même demande. L'e-mail n'arrive qu'à moi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub सार्वजनिक है, दूसरे भी उसी अनुरोध का समर्थन कर सकते हैं। ईमेल सिर्फ़ मुझ तक पहुँचता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub è pubblico e altri possono sostenere la stessa richiesta. L'email arriva solo a me."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubは公開で、同じ要望に他の人も賛同できます。メールは私にだけ届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub는 공개라 다른 사람도 같은 요청에 힘을 보탤 수 있습니다. 이메일은 저에게만 옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub is openbaar en anderen kunnen hetzelfde verzoek steunen. De e-mail komt alleen bij mij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub jest publiczny, inni mogą poprzeć tę samą prośbę. E-mail trafia tylko do mnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GitHub é público e outras pessoas podem apoiar o mesmo pedido. O e-mail chega só para mim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub публичный: другие могут поддержать тот же запрос. Письмо придёт только мне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub är offentligt och andra kan stödja samma önskemål. E-posten når bara mig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub herkese açıktır, başkaları aynı isteği destekleyebilir. E-posta yalnızca bana ulaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub публічний: інші можуть підтримати той самий запит. Лист отримаю тільки я."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 是公开的，其他人可以为同一需求投票。邮件只有我能看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 是公開的，其他人可以支持同一項需求。郵件只有我看得到。"
          }
        }
      }
    },
