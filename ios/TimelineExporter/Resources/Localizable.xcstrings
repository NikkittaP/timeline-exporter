        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application évolue selon les demandes des utilisateurs. Aucune analytique : dites-moi ce qui manque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऐप उपयोगकर्ताओं के अनुरोध पर बढ़ता है। इसमें कोई एनालिटिक्स नहीं है — बताइए क्या कमी है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
