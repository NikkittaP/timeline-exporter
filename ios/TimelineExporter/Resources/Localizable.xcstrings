        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह Google Timeline फ़ाइल नहीं लगती। Google Maps से एक्सपोर्ट की गई Timeline.json फ़ाइल चुनें — चरणों के लिए “मदद” पर टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo non sembra un file di Google Timeline. Scegli il file Timeline.json esportato da Google Maps — tocca «Aiuto» per i passaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは Google タイムラインのファイルではないようです。Google マップからエクスポートした Timeline.json を選択してください。手順は「ヘルプ」をご覧ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 타임라인 파일이 아닌 것 같습니다. Google 지도에서 내보낸 Timeline.json 파일을 선택하세요. 단계는 「도움말」을 참고하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit lijkt geen Google Timeline-bestand. Kies het Timeline.json-bestand dat je uit Google Maps hebt geëxporteerd — tik op „Help“ voor de stappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie wygląda na plik Google Timeline. Wybierz plik Timeline.json wyeksportowany z Map Google — dotknij „Pomoc“, aby zobaczyć kroki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não parece um arquivo do Google Timeline. Escolha o Timeline.json que você exportou do Google Maps — toque em «Ajuda» para ver as etapas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не похоже на файл Google Timeline. Выберите файл Timeline.json, экспортированный из Google Карт — нажмите «Справка», чтобы увидеть шаги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här ser inte ut som en Google Timeline-fil. Välj filen Timeline.json som du exporterade från Google Maps — tryck på ”Hjälp” för stegen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bir Google Timeline dosyası gibi görünmüyor. Google Haritalar'dan dışa aktardığınız Timeline.json dosyasını seçin — adımlar için «Yardım»a dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це не схоже на файл Google Timeline. Виберіть файл Timeline.json, експортований із Google Карт — натисніть «Довідка», щоб побачити кроки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这看起来不是 Google 时间线文件。请选择你从 Google 地图导出的 Timeline.json — 点按“帮助”查看步骤。"
          }
