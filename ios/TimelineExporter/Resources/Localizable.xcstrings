        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet iedereen die rondreist is verdwaald. Sommigen nemen gewoon hun tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wszyscy wędrowcy są zagubieni. Niektórzy po prostu się nie spieszą."
