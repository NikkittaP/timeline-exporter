<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a stylised GPS track.

    Coordinate space is 108x108 dp. The launcher's "safe zone" (always
    visible regardless of mask shape) is roughly 25..83 (centre 58x58).
    The design stays inside ~28..86 so it survives circle, squircle,
    teardrop and squared masks.

    All shapes are pure white — same drawable doubles as the monochrome
    layer for Android 13+ themed icons, where the system tints it to
    match the user's wallpaper accent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Track polyline -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 32,78 L 44,60 L 58,66 L 66,48 L 78,54 L 84,36" />

    <!-- Start dot (bottom-left) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 32,78 m -7,0 a 7,7 0 1,0 14,0 a 7,7 0 1,0 -14,0" />

    <!-- End dot (top-right) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 84,36 m -7,0 a 7,7 0 1,0 14,0 a 7,7 0 1,0 -14,0" />
</vector>
