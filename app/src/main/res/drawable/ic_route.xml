<?xml version="1.0" encoding="utf-8"?>
<!--
  "Show the whole track": the button that reframes the map on the data after
  the user has panned or zoomed away.

  A route between two endpoints rather than the "crop_free" frame this
  replaced. The frame said "fit something into the view" without saying what,
  and read as a near-duplicate of the fullscreen control stacked above it —
  both were four corner brackets. What this button actually frames is the
  track, so the glyph is the track.

  Hand-authored rather than taken from Material Symbols, for the same reason
  the two content icons are: a stroked line with a dot at each end is a few
  numbers, and the icon pack is ~2 MB before shrinking.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5,19V14c0,-2 1.5,-3 4,-3h6c2.5,0 4,-1 4,-3V5" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M5,21.4a2.4,2.4 0 1,0 0,-4.8a2.4,2.4 0 1,0 0,4.8z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M19,7.4a2.4,2.4 0 1,0 0,-4.8a2.4,2.4 0 1,0 0,4.8z" />
</vector>
