    <string name="tipjar_title">Apoyar el desarrollo</string>
    <string name="tipjar_blurb">Timeline Exporter es gratuito, sin anuncios y de código abierto. Si te ha resultado útil, una pequeña propina llega directamente a mí. ¡Gracias por considerarlo!</string>
    <string name="tipjar_connecting">Conectando con Google Play…</string>
    <string name="tipjar_processing">Abriendo Google Play…</string>
    <string name="tipjar_no_products">Ahora mismo no hay opciones de propina disponibles. Normalmente significa que la app aún no está del todo configurada en Google Play. Inténtalo más tarde.</string>
    <string name="tipjar_unavailable">Google Play Billing no está disponible en este dispositivo. Las propinas requieren los servicios de Google Play.</string>
    <string name="tipjar_thank_you">¡Gracias! 💜</string>
