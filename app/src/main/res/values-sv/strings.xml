    <string name="help_title">Hämta dina Timeline-data</string>
    <string name="help_intro">Sedan slutet av 2024 lagrar Google Timeline endast på din enhet — det finns inget Google Takeout-alternativ och ingen tredjepartsapp som kan läsa den direkt. Du exporterar den en gång från systeminställningarna och öppnar sedan filen här.</string>

    <string name="help_method_settings_title">Exportera från Android-inställningarna (rekommenderas)</string>
    <string name="help_method_settings_step1">Öppna appen Inställningar i Android</string>
    <string name="help_method_settings_step2">Tryck på Plats → Platstjänster</string>
    <string name="help_method_settings_step3">Tryck på Tidslinje (Timeline)</string>
    <string name="help_method_settings_step4">Tryck på ”Exportera Timeline-data”</string>
    <string name="help_method_settings_step5">Autentisera när du ombeds</string>
    <string name="help_method_settings_step6">Välj var filen ska sparas</string>
    <string name="help_method_settings_button">Öppna platsinställningar →</string>

    <string name="help_method_maps_title">Alternativ: exportera från Google Maps</string>
    <string name="help_method_maps_step1">Öppna Google Maps</string>
    <string name="help_method_maps_step2">Tryck på din profilbild (uppe till höger)</string>
    <string name="help_method_maps_step3">Välj ”Din tidslinje”</string>
    <string name="help_method_maps_step4">Tryck på menyn ⋯ (uppe till höger)</string>
    <string name="help_method_maps_step5">Tryck på ”Inställningar för plats och integritet”</string>
    <string name="help_method_maps_step6">Tryck på ”Exportera Timeline-data”</string>
    <string name="help_method_maps_button">Öppna Google Maps →</string>

    <string name="help_import_title">Få in filen i den här appen</string>
    <string name="help_import_step1">Öppna din Filer-app, hitta Timeline.json, tryck på Dela → ”Timeline Exporter”, eller</string>
    <string name="help_import_step2">Tryck på ”Välj Timeline.json” ovan och bläddra till filen.</string>

    <string name="help_notes_title">Anmärkningar</string>
    <string name="help_note_file_location">• Den exporterade filen heter Timeline.json. Den hamnar där du valde vid exporten — vissa Android-versioner begränsar åtkomsten till vissa mappar (t.ex. Nedladdningar), så om appen inte kan läsa den, prova att flytta den.</string>
    <string name="help_note_eu_csv">• EU-användare kan av integritetsskäl få en CSV i stället för JSON. Den här versionen av appen hanterar bara JSON.</string>
    <string name="help_note_slow_first">• Den första exporten kan ta en eller två minuter om du har flera års platshistorik.</string>

