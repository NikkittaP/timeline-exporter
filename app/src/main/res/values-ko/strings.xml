    <string name="feedback_other_label">그 밖에 필요한 것이 있나요?</string>
    <string name="feedback_diagnostics_label">기술 정보</string>
    <string name="feedback_diagnostics_note">앱이 스스로 보내는 것은 없습니다. 초안은 브라우저나 메일 앱에서 열리며, 보내기 전에 얼마든지 고치거나 지울 수 있습니다.</string>
    <string name="feedback_send_github">GitHub 이슈 열기</string>
    <string name="feedback_send_email">이메일 보내기</string>
