    <string name="feedback_diagnostics_label">Technische Angaben</string>
    <string name="feedback_diagnostics_note">Die App sendet nichts von selbst. Der Entwurf öffnet sich im Browser oder in der Mail-App — du kannst alles vor dem Senden ändern oder löschen.</string>
