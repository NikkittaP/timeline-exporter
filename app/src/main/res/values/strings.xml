    <!-- Help dialog -->
    <string name="help_title">Getting your Timeline data</string>
    <string name="help_intro">Since late 2024 Google stores Timeline only on your device — there\'s no Google Takeout option and no third-party app can read it directly. You export it once from system Settings, then bring the file here.</string>

    <string name="help_method_settings_title">Export from Android Settings (recommended)</string>
    <string name="help_method_settings_step1">Open the Android Settings app</string>
    <string name="help_method_settings_step2">Tap Location → Location services</string>
    <string name="help_method_settings_step3">Tap Timeline</string>
    <string name="help_method_settings_step4">Tap \'Export Timeline data\'</string>
    <string name="help_method_settings_step5">Authenticate when prompted</string>
    <string name="help_method_settings_step6">Choose where to save the file</string>
    <string name="help_method_settings_button">Open Location settings →</string>

    <string name="help_method_maps_title">Alternative: export from Google Maps</string>
    <string name="help_method_maps_step1">Open Google Maps</string>
    <string name="help_method_maps_step2">Tap your profile picture (top right)</string>
    <string name="help_method_maps_step3">Choose \'Your Timeline\'</string>
    <string name="help_method_maps_step4">Tap the ⋯ menu (top right)</string>
    <string name="help_method_maps_step5">Tap \'Location and privacy settings\'</string>
    <string name="help_method_maps_step6">Tap \'Export Timeline data\'</string>
    <string name="help_method_maps_button">Open Google Maps →</string>

    <string name="help_import_title">Bring the file into this app</string>
    <string name="help_import_step1">Open your Files app, find Timeline.json, tap Share → \'Timeline Exporter\', or</string>
    <string name="help_import_step2">Tap \'Pick Timeline.json\' above and browse to the file.</string>

    <string name="help_notes_title">Notes</string>
    <string name="help_note_file_location">• The exported file is named Timeline.json. It lands wherever you chose during export — some Android versions restrict access to certain folders (e.g. Downloads), so if this app can\'t read it, try moving it.</string>
    <string name="help_note_eu_csv">• EU users may receive a CSV instead of JSON for privacy-law reasons. This version of the app only handles JSON.</string>
    <string name="help_note_slow_first">• The first export can take a minute or two if you have years of location history.</string>
    <string name="help_note_csv_local_time">• CSV files carry both UTC time and local time (with the UTC offset), when the Timeline file records the timezone.</string>

