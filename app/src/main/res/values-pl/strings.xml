    <string name="tipjar_title">Wesprzyj rozwój</string>
    <string name="tipjar_blurb">Timeline Exporter jest darmowy, bez reklam i open source. Jeśli okazał się przydatny, mały napiwek trafia bezpośrednio do mnie. Dziękuję, że bierzesz to pod uwagę!</string>
    <string name="tipjar_connecting">Łączenie z Google Play…</string>
    <string name="tipjar_processing">Otwieranie Google Play…</string>
    <string name="tipjar_no_products">Obecnie brak dostępnych opcji napiwku. Zwykle oznacza to, że aplikacja nie jest jeszcze w pełni skonfigurowana w Google Play. Spróbuj ponownie później.</string>
    <string name="tipjar_unavailable">Google Play Billing jest niedostępne na tym urządzeniu. Napiwki wymagają usług Google Play.</string>
    <string name="tipjar_thank_you">Dziękuję! 💜</string>
    <string name="tipjar_thank_you_detail">Twój napiwek naprawdę pomaga. Mam nadzieję, że aplikacja pozostanie przydatna!</string>
    <string name="tipjar_tip_again">Daj napiwek ponownie</string>
    <string name="tipjar_error">Coś poszło nie tak z zakupem.</string>
    <string name="tipjar_retry">Spróbuj ponownie</string>
    <string name="tipjar_close">Zamknij</string>

    <!-- Feedback dialog (v1.5.0) -->
    <string name="feedback_help_button">Zaproponuj funkcję lub zgłoś problem →</string>
    <string name="feedback_title">Czego brakuje?</string>
    <string name="feedback_intro">Aplikacja rozwija się dzięki prośbom użytkowników. Nie ma w niej analityki — nie widzę, jak z niej korzystasz, więc pytam wprost. Zaznacz, co Cię interesuje, i wybierz sposób wysyłki.</string>
    <string name="feedback_option_area">Zachowanie tylko punktów w wybranym obszarze na mapie</string>
    <string name="feedback_option_file_per_trip">Osobny plik na każdą podróż zamiast jednego dużego</string>
    <string name="feedback_option_elevation_speed">Wysokość i prędkość w GPX</string>
    <string name="feedback_option_places">Eksport odwiedzonych miejsc, nie tylko trasy</string>
    <string name="feedback_option_share">Wysyłanie eksportu prosto do innej aplikacji zamiast zapisu pliku</string>
    <string name="feedback_option_trip_list">Lista podróży z początkiem, końcem, czasem i dystansem</string>
    <string name="feedback_option_stats">Podsumowania miesięczne i roczne, najczęściej odwiedzane miejsca</string>
    <string name="feedback_option_merge">Łączenie kilku plików Timeline</string>
    <string name="feedback_option_photo_geotag">Geotagowanie zdjęć według czasu</string>
    <string name="feedback_other_label">Coś jeszcze?</string>
    <string name="feedback_diagnostics_label">Dane techniczne</string>
    <string name="feedback_diagnostics_note">Aplikacja sama nic nie wysyła. Wersja robocza otworzy się w przeglądarce lub poczcie — przed wysłaniem możesz wszystko zmienić lub usunąć.</string>
