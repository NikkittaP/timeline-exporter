    <string name="help_title">获取你的时间轴数据</string>
    <string name="help_intro">自 2024 年底起，Google 仅将时间轴存储在你的设备上——没有 Google Takeout 选项，也没有可直接读取它的第三方应用。你从系统设置中导出一次，然后在这里打开该文件。</string>

    <string name="help_method_settings_title">从 Android 设置导出（推荐）</string>
    <string name="help_method_settings_step1">打开 Android “设置”应用</string>
    <string name="help_method_settings_step2">点按“位置信息”→“位置信息服务”</string>
    <string name="help_method_settings_step3">点按“时间轴”</string>
    <string name="help_method_settings_step4">点按“导出时间轴数据”</string>
    <string name="help_method_settings_step5">出现提示时进行验证</string>
    <string name="help_method_settings_step6">选择文件的保存位置</string>
    <string name="help_method_settings_button">打开位置信息设置 →</string>

    <string name="help_method_maps_title">备选：从 Google 地图导出</string>
    <string name="help_method_maps_step1">打开 Google 地图</string>
    <string name="help_method_maps_step2">点按你的头像（右上角）</string>
    <string name="help_method_maps_step3">选择“你的时间轴”</string>
    <string name="help_method_maps_step4">点按 ⋯ 菜单（右上角）</string>
    <string name="help_method_maps_step5">点按“位置信息和隐私设置”</string>
    <string name="help_method_maps_step6">点按“导出时间轴数据”</string>
    <string name="help_method_maps_button">打开 Google 地图 →</string>

    <string name="help_import_title">将文件导入此应用</string>
    <string name="help_import_step1">打开“文件”应用，找到 Timeline.json，点按分享→“Timeline Exporter”，或</string>
    <string name="help_import_step2">点按上方的“选择 Timeline.json”并浏览到该文件。</string>

    <string name="help_notes_title">备注</string>
    <string name="help_note_file_location">• 导出的文件名为 Timeline.json。它会保存在你导出时选择的位置——某些 Android 版本会限制对特定文件夹（如“下载”）的访问，因此如果应用无法读取，请尝试移动该文件。</string>
    <string name="help_note_eu_csv">• 出于隐私法规的原因，欧盟用户可能会收到 CSV 而非 JSON。此版本的应用仅支持 JSON。</string>
    <string name="help_note_slow_first">• 如果你有数年的位置信息记录，首次导出可能需要一两分钟。</string>

